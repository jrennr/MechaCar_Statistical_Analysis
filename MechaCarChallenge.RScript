mpg_path <- "MechaCar_mpg[1].csv"
mecha_car_data <- read.csv(mpg_path)
lm_model <- lm(mpg ~ vehicle_length + vehicle_weight + spoiler_angle + ground_clearance + AWD, data = mecha_car_data)
print(summary(lm_model))

coil_path <- "Suspension_Coil.csv"
if (file.exists(coil_path)) {
    suspension_coil_data <- read.csv(coil_path)
    required_columns <- c("Manufacturing_Lot", "PSI")
    if (!all(required_columns %in% names(suspension_coil_data))) {
        stop("Suspension_Coil.csv must contain Manufacturing_Lot and PSI columns.")
    }
    suspension_coil_data <- suspension_coil_data[complete.cases(suspension_coil_data[, required_columns]), ]
    summarize_psi <- function(values) {
        c(Mean = mean(values), Median = median(values), Variance = var(values), SD = sd(values))
    }
    print(summarize_psi(suspension_coil_data$PSI))
    print(aggregate(PSI ~ Manufacturing_Lot, suspension_coil_data, summarize_psi))
    print(t.test(suspension_coil_data$PSI, mu = 1500))
    lots <- split(suspension_coil_data$PSI, suspension_coil_data$Manufacturing_Lot)
    for (lot in names(lots)) {
        cat("Manufacturing lot:", lot, "\n")
        print(t.test(lots[[lot]], mu = 1500))
    }
}
